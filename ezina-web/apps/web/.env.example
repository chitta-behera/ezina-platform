# Ezina marketing site (apps/web). The site builds with none of these set.
# NEXT_PUBLIC_* values are baked into the static HTML/JS at build time. Never put secrets here.

# Contact form (/contact). See README "Contact form API contract".
# "mock" (default): no network request; waits ~1 s, logs the payload to the browser console and shows success.
# "api": POSTs JSON to NEXT_PUBLIC_CONTACT_API_URL (15 s timeout).
NEXT_PUBLIC_CONTACT_MODE=mock
# Endpoint for "api" mode, e.g. https://api.ezina.ai/v1/contact (or a same-origin path such as /api/contact)
NEXT_PUBLIC_CONTACT_API_URL=
