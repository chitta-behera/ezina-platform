# Copy to .env (never commit .env). Placeholders only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
META_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

# Pooled connection string from Neon/Supabase (postgresql://user:pass@host/db?sslmode=require) is accepted as-is.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required to use /api/admin/* and /api/whatsapp/send (they are disabled while empty).
ADMIN_API_KEY=

MEDIA_STORAGE_BACKEND=local   # local | s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Identity images (ID photo + selfie): a SEPARATE private, server-side-encrypted bucket. Required when MEDIA_STORAGE_BACKEND=s3.
# Never make it public; images are not served by URL.
S3_IDENTITY_BUCKET=
# Local backend only: where identity images go (default: <MEDIA_LOCAL_DIR>_identity)
# IDENTITY_LOCAL_DIR=

LOG_LEVEL=INFO
APP_ENV=development           # development | production

# Identity verification (defaults shown)
IDENTITY_MAX_ATTEMPTS=3             # failed uploads per image before NEEDS_HELP (ops follow-up) and the flow moves on
IDENTITY_MIN_IMAGE_PX=600           # minimum length of the shorter side of an ID photo / selfie
# IDENTITY_MAX_BYTES=10485760
SELFIE_CHALLENGE_TTL_MINUTES=10     # a selfie must arrive within this long of its liveness challenge

# Optional
# WHATSAPP_TEMPLATE_VERIFICATION=ezina_verification_update   # approved template, 1 body param, for messages outside 24h
# OPS_WEBHOOK_URL=                                           # POSTed when a farmer is handed to a human
# MIN_FARM_PHOTOS=1
