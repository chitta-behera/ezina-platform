# Copy to .env (never commit .env). Placeholders only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
META_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

# Pooled connection string from Neon/Supabase (postgresql://user:pass@host/db?sslmode=require) is accepted as-is.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required to use /api/admin/* and /api/whatsapp/send (they are disabled while empty).
ADMIN_API_KEY=

MEDIA_STORAGE_BACKEND=local   # local | s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Identity images (ID photo + selfie): a SEPARATE private, server-side-encrypted bucket. Required when MEDIA_STORAGE_BACKEND=s3.
# Never make it public; images are not served by URL.
S3_IDENTITY_BUCKET=
# Local backend only: where identity images go (default: <MEDIA_LOCAL_DIR>_identity)
# IDENTITY_LOCAL_DIR=

LOG_LEVEL=INFO
APP_ENV=development           # development | production

# Identity verification (defaults shown)
IDENTITY_MAX_ATTEMPTS=3             # failed uploads per image before NEEDS_HELP (ops follow-up) and the flow moves on
IDENTITY_MIN_IMAGE_PX=600           # minimum length of the shorter side of an ID photo / selfie
# IDENTITY_MAX_BYTES=10485760
SELFIE_CHALLENGE_TTL_MINUTES=10     # a selfie must arrive within this long of its liveness challenge

# ID name check: the ezina_id_verify package (AWS Rekognition, called in-process) reads the name on the ID front; Python
# compares it with the name the farmer gave. Advisory only (it never verifies anyone). Which ID types are checked, and the
# ezina_id_verify doc_type for each (`verify_doc_type`), is configured in ezina-connect/app/config/id_documents.yaml
# (section `extraction`); an ID type without an entry (e.g. KCC) is skipped. AWS settings and credentials: see the
# "ID verification module" section below. ezina_id_verify retries AWS errors itself, so there are no retry settings here.
DOC_EXTRACT_ENABLED=false           # true | false
NAME_MATCH_THRESHOLD=90             # score >= this: MATCHED
NAME_PARTIAL_THRESHOLD=75           # score >= this: PARTIAL, below: MISMATCH
NAME_CHECK_MAX_ATTEMPTS=3           # failed comparisons (name changes + new IDs) before NEEDS_HELP

# Selfie face check: ezina_id_verify (AWS Rekognition) compares the selfie with the photo on the ID front. Advisory only
# (it never verifies anyone); the scores are for the operations team and are never shown to the farmer. Liveness stays
# the WhatsApp finger challenge (Rekognition reports none). The match thresholds are FACE_MATCH_THRESHOLD and
# FACE_POSSIBLE_MATCH_THRESHOLD below. Rekognition can take ~5-10 seconds: the farmer sees a "checking" message first.
FACE_VERIFY_ENABLED=false           # true | false
FACE_VERIFY_MAX_ATTEMPTS=3          # failed face checks (new selfies + new IDs) before NEEDS_HELP

# Optional
# WHATSAPP_TEMPLATE_VERIFICATION=ezina_verification_update   # approved template, 1 body param, for messages outside 24h
# OPS_WEBHOOK_URL=                                           # POSTed when a farmer is handed to a human
# MIN_FARM_PHOTOS=1

# ---- ID verification module (ezina_id_verify/, AWS Rekognition): name extraction + face match ----
# ANTHROPIC_API_KEY, CLAUDE_MODEL and LOG_LEVEL above are shared with this module.
# AWS credentials use the standard AWS credential chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the environment,
# ~/.aws/credentials, or an IAM role). Do not put real keys in this file. IAM needs:
# rekognition:DetectText, rekognition:DetectFaces, rekognition:CompareFaces
AWS_REGION=us-east-1
MAX_UPLOAD_MB=10                    # larger uploads are rejected (JPEG and PNG only)
NAME_CASE=upper                     # upper | title | original
LLM_FALLBACK_ENABLED=false          # true: Claude reads the name if OCR strategies fail (needs ANTHROPIC_API_KEY + CLAUDE_MODEL)
FACE_MATCH_THRESHOLD=90             # similarity >= this: verified
FACE_POSSIBLE_MATCH_THRESHOLD=75    # similarity >= this (and below the match threshold): possible_match
FACE_MIN_SHARPNESS=20               # selfie sharpness below this: warning "selfie_blurry"
FACE_MIN_BRIGHTNESS=30              # selfie brightness below this: warning "selfie_dark"
ID_VERIFY_API_KEY=                  # optional HTTP wrapper only (X-API-Key). Empty = open: local development only
# Optional tuning (defaults shown):
# AWS_MAX_RETRIES=3                 # retries on throttling / 5xx / network errors
# AWS_RETRY_BASE_DELAY=0.5          # backoff base, seconds
# FACE_ID_MIN_WIDTH=0.06            # ID face narrower than this (fraction of the image width): warning "small_face_id"
# ID_VERIFY_DOCUMENTS_CONFIG=       # path to a documents.yaml that replaces the bundled one
